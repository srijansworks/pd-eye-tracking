# Copy to .env.local. Values for `supabase start` are printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# No service-role key is needed: device uploads are authorized inside Postgres
# by per-device keys (see docs/API.md). Never put a service-role key in NEXT_PUBLIC_*.
